{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "Backend API (FastAPI)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "ETL Pipeline",
      "runtimeExecutable": "python",
      "runtimeArgs": ["etl/run.py"],
      "port": null
    }
  ]
}
